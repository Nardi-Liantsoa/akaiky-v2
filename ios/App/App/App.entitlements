<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notifications push (NAR-179). « development » pour les builds de développement :
	     l'export App Store le remplace par « production » (profil de distribution). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
