# Copier en server/.env.dev (ignoré par git) pour `npm run dev:api`.
PORT=8787
DATABASE_URL=postgres://app:app-dev-local@127.0.0.1:5433/akaiky_v2
APP_ORIGIN=http://localhost:5173
# Application native en développement (API locale exposée en https par un
# tunnel, voir docs/MOBILE.md) :
NATIVE_ORIGINS=https://localhost,capacitor://localhost
# Sans SMTP_HOST, les emails (liens de confirmation, réinitialisation)
# s'affichent dans le terminal de l'API.
