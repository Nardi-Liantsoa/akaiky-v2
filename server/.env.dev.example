# Copier en server/.env.dev (ignoré par git) pour `npm run dev:api`.
PORT=8787
DATABASE_URL=postgres://app:app-dev-local@127.0.0.1:5433/akaiky_v2
APP_ORIGIN=http://localhost:5173
# Application native en développement (API locale exposée en https par un
# tunnel, voir docs/MOBILE.md) :
NATIVE_ORIGINS=https://localhost,capacitor://localhost
# Sans SMTP_HOST, les emails (liens de confirmation, réinitialisation)
# s'affichent dans le terminal de l'API.
# Notifications push (NAR-141) : fake (défaut hors production, envois gardés en mémoire),
# none, ou fcm avec le compte de service Firebase (JSON, ou chemin absolu d'un fichier
# HORS du dépôt). Jamais de compte de service dans le dépôt ni dans le bundle.
PUSH_PROVIDER=fake
# SMS d'authentification (NAR-136) : fake (défaut hors production, mémoire) ; avec SMS_OUTBOX,
# une ligne JSON par SMS dans ce fichier (le code de confirmation s'y lit : jamais dans le terminal).
# none : aucun envoi. Refusés en production : fake et SMS_OUTBOX.
SMS_PROVIDER=fake
# SMS_OUTBOX=/tmp/akaiky-v2-sms.jsonl
# FCM_SERVICE_ACCOUNT=/Users/<vous>/.config/akaiky-v2/firebase-service-account.json
# APK de l'app enfant (NAR-165, NAR-170) : QR d'appairage et mise à jour des téléphones (NOSYHOST.md § 6).
# DEVICE_APK_URL=http://127.0.0.1:8080/downloads/akaiky-enfant.apk
# DEVICE_APK_SIGNATURE_SHA256=<SHA-256 du certificat, base64url>
# DEVICE_APK_VERSION_CODE=<versionCode de l'APK publié ; exigé en production avec DEVICE_APK_URL>
# DEVICE_APK_SHA256=<SHA-256 hexadécimal du fichier ; seulement si l'APK est servi ailleurs>
# Serveur OTA (NAR-189) : limites par IP (vérifications par minute, téléchargements par 15 min).
# OTA_RATE_LIMIT=60
# OTA_DOWNLOAD_RATE_LIMIT=30
# Fond de carte (NAR-205) : extrait PMTiles de Madagascar (docs/CARTE.md). Pour essayer avec le
# petit extrait d'Antananarivo des tests :
# MAP_TILES_FILE=../tests/fixtures/map/tana.pmtiles
