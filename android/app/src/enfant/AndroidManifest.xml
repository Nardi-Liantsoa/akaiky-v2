<?xml version="1.0" encoding="utf-8"?>
<!-- Variante « enfant » seulement (NAR-164) : Device Owner par QR de provisionnement. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Appel d'un contact en un appui (NAR-142) ; accordée d'office en Device Owner. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Durée des appels sortants pour le journal parent (NAR-166) ; accordée d'office en Device Owner. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Fin de la sortie temporaire à l'heure, app fermée (NAR-167). USE_EXACT_ALARM : APK
         distribué hors Play Store (aucune règle de store) ; SCHEDULE_EXACT_ALARM pour Android 12. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <application>
        <!-- Lanceur du téléphone de l'enfant (NAR-167) : l'accueil et le redémarrage
             ramènent à l'app ; Kiosk la désigne lanceur par défaut une fois armée. -->
        <activity android:name="mg.nosytech.akaiky.MainActivity" tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver android:name="mg.nosytech.akaiky.RelockReceiver" android:exported="false" />

        <!-- Filtre des appels entrants (NAR-145), Android 10+ avec le rôle ROLE_CALL_SCREENING :
             seuls les contacts autorisés sonnent. Lié par Telecom seulement (permission). -->
        <service
            android:name="mg.nosytech.akaiky.AkaikyCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <receiver
            android:name="mg.nosytech.akaiky.AkaikyDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Appelées par le système pendant le provisionnement (Android 10+), protégées
             par BIND_DEVICE_ADMIN : aucune autre app ne peut les lancer. -->
        <activity
            android:name="mg.nosytech.akaiky.ProvisioningModeActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="mg.nosytech.akaiky.PolicyComplianceActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Fin du provisionnement : ouvre l'app (le jeton d'appairage ne vaut que 15 minutes). -->
        <activity
            android:name="mg.nosytech.akaiky.ProvisioningSuccessActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.PROVISIONING_SUCCESSFUL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
