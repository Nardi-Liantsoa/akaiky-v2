<?xml version="1.0" encoding="utf-8"?>
<!-- Variante « enfant » seulement (NAR-164) : Device Owner par QR de provisionnement. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Appel d'un contact en un appui (NAR-142) ; accordée d'office en Device Owner. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Durée des appels sortants pour le journal parent (NAR-166) ; accordée d'office en Device Owner. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- Filtre des appels sortants d'Android 8–9 (NAR-169), accordée d'office en Device Owner. -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <!-- Fin de la sortie temporaire à l'heure, app fermée (NAR-167). USE_EXACT_ALARM : APK
         distribué hors Play Store (aucune règle de store) ; SCHEDULE_EXACT_ALARM pour Android 12. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- Surveillance en arrière-plan (NAR-180) : tâche WorkManager et écoute reposées au redémarrage. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- SOS hors ligne (NAR-151) : SMS aux parents avec la position, cascade d'appels (état de
         l'appel, fin d'un appel sans réponse), sirène. Permissions d'exécution accordées d'office
         en Device Owner (SosPlugin.grantAll). Service au premier plan « appel » et « position »
         (Android 14 : type et permission FOREGROUND_SERVICE_* ; MANAGE_OWN_CALLS est le
         prérequis du type phoneCall pour une app qui n'est pas le composeur par défaut). -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Applications autorisées (NAR-143) : visibilité des paquets d'Android 11+, pour lister les
         apps lançables, les lanceurs (jamais cachés) et les navigateurs (jamais autorisés). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
    </queries>
    <!-- EnfantApplication : restriction d'installation reposée dès le démarrage du processus (NAR-170). -->
    <application android:name="mg.nosytech.akaiky.EnfantApplication">
        <!-- Lanceur du téléphone de l'enfant (NAR-167) : l'accueil et le redémarrage
             ramènent à l'app ; Kiosk la désigne lanceur par défaut une fois armée. -->
        <activity android:name="mg.nosytech.akaiky.MainActivity" tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver android:name="mg.nosytech.akaiky.RelockReceiver" android:exported="false" />
        <!-- Mise à jour de l'app par elle-même (NAR-170) : résultat de PackageInstaller et
             alarme de sécurité de la fenêtre d'installation (PendingIntent explicites). -->
        <receiver android:name="mg.nosytech.akaiky.ApkUpdateReceiver" android:exported="false" />

        <!-- SOS hors ligne (NAR-151) : survit à l'écran éteint ; lancé par l'écran seulement. -->
        <service
            android:name="mg.nosytech.akaiky.SosService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|location" />

        <!-- Signal de vie en arrière-plan (NAR-180) : seules les diffusions exemptées des
             restrictions d'Android 8 (batterie et SIM_STATE_CHANGED : écoute à l'exécution,
             BackgroundStatus.kt). Exporté pour les recevoir du système ; l'intention n'est
             jamais lue, l'état réel est relu. -->
        <receiver android:name="mg.nosytech.akaiky.BackgroundStatusReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.telephony.action.CARRIER_CONFIG_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Filtre des appels entrants (NAR-145), Android 10+ avec le rôle ROLE_CALL_SCREENING :
             seuls les contacts autorisés sonnent. Lié par Telecom seulement (permission). -->
        <service
            android:name="mg.nosytech.akaiky.AkaikyCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- Filtre des appels sortants (NAR-169) : Android 10+ avec le rôle ROLE_CALL_REDIRECTION
             (lié par Telecom seulement), Android 8–9 par NEW_OUTGOING_CALL (diffusion protégée,
             envoyée par le système seul, exemptée des restrictions d'Android 8). Seuls un contact joignable
             et un numéro d'urgence sont composés. -->
        <service
            android:name="mg.nosytech.akaiky.AkaikyCallRedirectionService"
            android:permission="android.permission.BIND_CALL_REDIRECTION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallRedirectionService" />
            </intent-filter>
        </service>
        <!-- Récepteur d'Android 8–9 seulement (désactivé à partir d'Android 10 par
             values-v29/bools.xml). Refus : resultData vidé et diffusion interrompue. -->
        <receiver
            android:name="mg.nosytech.akaiky.OutgoingCallReceiver"
            android:enabled="@bool/outgoing_receiver_enabled"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.NEW_OUTGOING_CALL" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="mg.nosytech.akaiky.AkaikyDeviceAdminReceiver"
            android:description="@string/device_admin_description"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- Appelées par le système pendant le provisionnement (Android 10+), protégées
             par BIND_DEVICE_ADMIN : aucune autre app ne peut les lancer. -->
        <activity
            android:name="mg.nosytech.akaiky.ProvisioningModeActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.GET_PROVISIONING_MODE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity
            android:name="mg.nosytech.akaiky.PolicyComplianceActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.ADMIN_POLICY_COMPLIANCE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Fin du provisionnement : ouvre l'app (le jeton d'appairage ne vaut que 15 minutes). -->
        <activity
            android:name="mg.nosytech.akaiky.ProvisioningSuccessActivity"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.app.action.PROVISIONING_SUCCESSFUL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
