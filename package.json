{
  "name": "akaiky-v2",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "npm install --prefix server --no-audit --no-fund",
    "dev": "vite",
    "dev:db": "docker compose -f compose.dev.yml up -d",
    "dev:api": "cd server && node --env-file=.env.dev --watch src/server.js",
    "dev:seed": "cd server && node --env-file=.env.dev bin/dev-seed.js",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:api": "npm test --prefix server",
    "test:all": "npm run lint && npm run build && npm test && npm run test:api && npm run test:e2e",
    "sync": "npm run build && npx cap sync",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "icons": "npx --yes @capacitor/assets@3 generate --iconBackgroundColor '#ffffff'",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test",
    "recette": "node scripts/recette.mjs",
    "test:visual": "sh scripts/visual.sh",
    "android:parent": "npm run build && npx cap sync android && cd android && ./gradlew assembleParentDebug",
    "android:enfant": "npm run build && npx cap sync android && cd android && ./gradlew assembleEnfantDebug",
    "android:both": "npm run build && npx cap sync android && cd android && ./gradlew assembleParentDebug assembleEnfantDebug",
    "audit:deps": "node scripts/audit.mjs",
    "android:enfant:release": "sh scripts/android-release-enfant.sh"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-firebase/messaging": "8.6.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.2",
    "@capgo/capacitor-updater": "^8.49.1",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.18.0",
    "pmtiles": "4.5.0",
    "qrcode": "1.5.4",
    "vue": "^3.5.38",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/ios": "^8.4.0",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.0.0",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-legacy": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.16",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.5"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
